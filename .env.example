# Kaiferdata frontend environment.
# These are PUBLIC values (safe to ship to the browser). Copy to `.env` and fill in.
# NEVER put a service-role key, Paystack secret, or any supplier API key in a
# VITE_-prefixed variable — anything VITE_* is bundled into the public client.

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_APK_URL="https://example.com/app.apk"

# Backend API Keys (add to Supabase Edge Function Secrets, not VITE_)
INSTANT_DATA_API_KEY="your_instant_data_api_key_here"
